{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "phosphor-react-native/src/defs/*": ["../node_modules/phosphor-react-native/src/defs/*"]
    },
    "types": ["node", "react"]
  },
  "include": ["src", "tests"]
}
