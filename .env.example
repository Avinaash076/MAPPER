# Optional community service. These are public client settings, not admin keys.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only after applying the quota migration, setting server secrets and deploying travel-services.
EXPO_PUBLIC_TRAVEL_SERVICES_ENABLED=false
# Never place service_role, database passwords or AI secrets in EXPO_PUBLIC_ variables.
