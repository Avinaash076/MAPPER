# SERVER ONLY. Copy to supabase/functions/.env.local; never commit real values.
GEOAPIFY_API_KEY=
MISTRAL_API_KEY=
# Choose a chat model enabled in your Mistral account; no model is silently substituted.
MISTRAL_MODEL=mistral-small-latest
# Opt into prototype only for non-commercial testing. Commercial use needs its own subscription.
OPEN_METEO_MODE=prototype
OPEN_METEO_API_KEY=
ALLOWED_APP_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are supplied by Supabase.
