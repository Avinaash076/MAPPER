{
  "expo": {
    "name": "Northern Trails",
    "slug": "northern-trails",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "northerntrails",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3F5F7",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.northerntrails.app"
    },
    "android": {
      "package": "com.northerntrails.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Save the location of a hidden place you choose to share."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach your chosen photos to a place draft.",
          "cameraPermission": "Take a photo for a place draft.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F5F7",
          "dark": {
            "backgroundColor": "#111B24"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
